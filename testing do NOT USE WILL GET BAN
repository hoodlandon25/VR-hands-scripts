-- Close Current Active Hub
local function destroyActiveHubs()
	local coreGui = game:GetService("CoreGui")
	local pGui = localPlayer:WaitForChild("PlayerGui")
	local targets = {
		coreGui:FindFirstChild("R4HandsHub_New"),
		coreGui:FindFirstChild("R4HandsHub_Old"),
		pGui:FindFirstChild("R4HandsHub_New"),
		pGui:FindFirstChild("R4HandsHub_Old"),
		pGui:FindFirstChild("InvisibilityGUI")
	}

	for _, gui in ipairs(targets) do
		if gui then
			pcall(function() gui:Destroy() end)
		end
	end

	-- Destroy temporary physics objects
	local invisChair = workspace:FindFirstChild("invischair")
	if invisChair then pcall(function() invisChair:Destroy() end) end

	-- Restore Camera Subject
	local hum = localPlayer.Character and localPlayer.Character:FindFirstChildOfClass("Humanoid")
	if hum then workspace.CurrentCamera.CameraSubject = hum end
end

-- Execute Selected Hub
local function executeHub(hubType)
	if currentActiveHub == hubType then
		createNotification("Notice", hubType .. " Hub is already currently running.", 2)
		return
	end

	destroyActiveHubs()
	currentActiveHub = hubType
	updateSideBarActiveStates()

	createNotification("Executing Hub", "Loading " .. hubType .. " Hub...", 3)

	task.spawn(function()
		local targetUrl = (hubType == "New") and SCRIPT_URLS.NEW_HUB or SCRIPT_URLS.OLD_HUB
		local success, err = pcall(function()
			loadstring(game:HttpGet(targetUrl))()
		end)

		if not success then
			currentActiveHub = nil
			updateSideBarActiveStates()
			createNotification("Execution Error", "Failed to load " .. hubType .. " Hub script.", 4)
			warn("[R4 Loader Error]: " .. tostring(err))
		end
	end)
end

